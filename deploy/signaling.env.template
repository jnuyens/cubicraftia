# /etc/cubicraftia/signaling.env  (Phase 11 DEPLOY-02/05)
# Consumed by cubicraftia-signaling.service (EnvironmentFile).
# Fill values from /etc/cubicraftia/secrets.env (same JWT secret + TURN secret as Supabase/coturn).
# Root-owned 0640 (group cubicraftia). NEVER commit real values.
PORT=8129
MAX_SESSIONS=200
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_JWT_SECRET=__from_secrets.env__
SUPABASE_SERVICE_KEY=__SERVICE_ROLE_KEY_from_secrets.env__
TURN_SHARED_SECRET=__from_secrets.env__
ADMIN_SECRET=__from_secrets.env__
# SMTP (parental consent) optional at go-live; fill when the mail relay is ready:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@cubicraftia.com
