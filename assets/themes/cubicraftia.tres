; ─── Theme resource ──────────────────────────────────────────────────────────

[resource]

; Default font size (body 16px regular)
default_font_size = 16

; Label
Label/font_sizes/font_size = 16
Label/colors/font_color = Color(0.945, 0.941, 0.918, 1.0)

; Button: navy background, brick-white text, rounded corners
Button/font_sizes/font_size = 14
Button/colors/font_color = Color(0.945, 0.941, 0.918, 1.0)
Button/colors/font_pressed_color = Color(0.106, 0.173, 0.337, 1.0)
Button/colors/font_hover_color = Color(1.0, 1.0, 1.0, 1.0)
Button/colors/font_disabled_color = Color(0.945, 0.941, 0.918, 0.5)
Button/styles/normal = SubResource("StyleBox_button_normal")
Button/styles/hover = SubResource("StyleBox_button_hover")
Button/styles/pressed = SubResource("StyleBox_button_pressed")
Button/styles/disabled = SubResource("StyleBox_button_disabled")
Button/styles/focus = SubResource("StyleBox_focus")

; PanelContainer: navy 0.92 alpha, rounded 16
PanelContainer/styles/panel = SubResource("StyleBox_panel")
