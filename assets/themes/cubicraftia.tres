border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.96, 0.76, 0.05, 1.0)

; ─── Phase 4: Multiplayer UI StyleBoxes (Plan 04-03) ─────────────────────────
; These are ADDITIVE — they do NOT mutate any Phase 1+2+3 entries.
; Applied programmatically in Phase 4 UI components (SessionPanel, RelayBadge, ChatPanel).
