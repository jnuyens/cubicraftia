; ─── Phase 3: InventorySlot state StyleBoxes (Plan 03-05) ────────────────────
; These are ADDITIVE — they do NOT mutate any Phase 1+2 entries.
; Applied programmatically in inventory_slot.gd (not via theme override lookup)
; so they do not affect PaletteTile or Hotbar visuals.

; InventorySlot empty state: no fill, 1px brick-white stroke at 50% alpha.
[sub_resource type="StyleBoxFlat" id="StyleBox_inv_slot_empty"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.945, 0.941, 0.914, 0.5)

; InventorySlot filled state: navy 50% alpha fill, 1px brick-white stroke.
[sub_resource type="StyleBoxFlat" id="StyleBox_inv_slot_filled"]
bg_color = Color(0.106, 0.173, 0.337, 0.5)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.945, 0.941, 0.914, 0.6)

; InventorySlot hover state: navy 85% alpha fill, 2px accent-yellow border.
[sub_resource type="StyleBoxFlat" id="StyleBox_inv_slot_hover"]
