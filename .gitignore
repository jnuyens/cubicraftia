# GSD planning artifacts
.planning/

# Godot build artifacts
.godot/
*.import
*.translation
export_presets.cfg.local
export.cfg
build/
# Textures Godot extracts from embedded-image .glb files on import (regenerated; source is the tracked .glb)
assets/meshes/npcs/*_texture_*.png

# Android signing — never commit keystores
release.keystore
release.keystore.b64

# Godot editor local overrides
override.cfg

# macOS
.DS_Store

# godot_voxel source checkout (installed by scripts/install-deps.sh; not committed)
addons/godot_voxel/

# Compiled GDExtension binaries (checked in when needed per platform, not generated locally)
addons/godot_voxel/bin/

# godot-sqlite GDExtension — installed by scripts/install-deps.sh; not committed
# Only addons/godot-sqlite/.gitkeep is tracked to anchor the directory.
addons/godot-sqlite/bin/
addons/godot-sqlite/gdsqlite.gdextension
addons/godot-sqlite/gdsqlite.gdextension.uid
addons/godot-sqlite/godot-sqlite.gd
addons/godot-sqlite/godot-sqlite.gd.uid
addons/godot-sqlite/plugin.cfg

# webrtc-native GDExtension — installed by scripts/install-deps.sh; not committed
# Only the manifest (webrtc_native.gdextension) is tracked in git.
addons/webrtc-native/bin/

# gettext compiled message files (generated artifacts)
*.mo

# Godot 4.x resource UID cache (generated artifacts — not committed)
*.uid

# GUT test reports (generated by CI and local test runs)
.gut_report.xml

# Temporary files
*.tmp
*.swp

# Go signaling server compiled binary (generated artifact)
signaling-server/signaling
signaling-server/cubicraftia-signaling
.gstack/

# Meshy rigging staging + outputs (large binaries, do not commit)
meshy-upload-queue/

# Loose art / audio / project drops at the repo ROOT (staging — processed into
# assets/, never committed loose at root). Keeps the working tree clean and the
# repo from bloating. Cubicraftia.png is the one tracked root image (kept).
/*.glb
/*.png
/*.jpg
/*.jpeg
/*.pxd
/*.wav
/*.ogg
/*.aup3
/*.rtf
!/Cubicraftia.png
# Local Claude Code session/tooling state
/.claude/

# Rigging experiment scratch (not for vcs)
rigify-test/

# Raw art-drop inputs (local source, never imported/packed by Godot)
_drop/*
!_drop/.gdignore
