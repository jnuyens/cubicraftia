;
; hp_bar.tscn — horizontal HP bar HUD node.
;
; Root: PanelContainer with hp_bar.gd script (framed panel behind the gauge).
; Anchored top-left of the parent CanvasLayer.
;
; The inner TextureProgressBar (driven by the xp_bar_fill.png gauge sprite) is
; built procedurally in hp_bar.gd _build_bar().

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/hp_bar.gd" id="1_hp_bar"]

[node name="HpBar" type="PanelContainer"]
script = ExtResource("1_hp_bar")
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 0.0
anchor_bottom = 0.0
offset_left = 0.0
offset_top = 0.0
