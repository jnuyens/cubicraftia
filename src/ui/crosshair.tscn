;
; crosshair.tscn — Centre-of-screen 12×12 crosshair reticle (Plan 02-09).
;
; Per UI-SPEC.md §Crosshair:
;   - 12×12px cross (+), 1px stroke, #F1F0EA with 1px #1B2C56 drop-shadow.
;   - Anchored to centre of the viewport using anchors_preset = CENTER (preset 8).
;   - Rendered via crosshair.gd _draw() override (not a TextureRect).
;   - Hidden on mobile when palette bottom sheet expands (mobile_overlay.gd).
;
; Node structure:
;   Crosshair (Control, script crosshair.gd)

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/crosshair.gd" id="1_crosshair"]

[node name="Crosshair" type="Control"]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -6.0
offset_top = -6.0
offset_right = 6.0
offset_bottom = 6.0
grow_horizontal = 2
grow_vertical = 2
custom_minimum_size = Vector2(12, 12)
mouse_filter = 2
script = ExtResource("1_crosshair")
