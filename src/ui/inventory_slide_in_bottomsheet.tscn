;
; inventory_slide_in_bottomsheet.tscn — Mobile bottom-sheet inventory slide-in.
;
; Per 03-UI-SPEC.md §"Inventory + Chest + Workbench Slide-In Layout Specification" L341-403:
;   - Anchored bottom of viewport; 48px collapsed peek, ~70% screen expanded.
;   - StyleBoxFlat: #1B2C56 0.92α, corner_radius 16 on top-left + top-right.
;   - DragHandle (32px tall) at top for gesture snap.
;   - Mobile cell sizes: 56×56 (set by _build_grid).
;   - Crafting cluster stacked vertically (no side-by-side HBox on mobile per UI-SPEC L62).
;
; InventorySlideIn.gd is attached with layout="bottomsheet".
; Slots built programmatically in _build_grid() and _build_crafting().
; Group: "inventory_slide_in".
;
; Bottom-sheet gesture: InputEventScreenTouch + InputEventScreenDrag + 0.22s ease-out cubic.

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/inventory_slide_in.gd" id="1_slide"]

; ─── Root Control ─────────────────────────────────────────────────────────────
; Starts at collapsed_y (only peek visible); animated by _animate_to on open.
[node name="InventorySlideInBottomsheet" type="Control"]
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_slide")
layout = "bottomsheet"

; ─── Drag Handle (32px tall, 48dp hit area) ───────────────────────────────────
; Connected to _on_drag_handle_input in _ready via gui_input signal.
[node name="DragHandle" type="Control" parent="."]
layout_mode = 0
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 0.0
offset_top = 0.0
offset_bottom = 48.0
custom_minimum_size = Vector2(0, 48)
mouse_filter = 0

; Visual drag-handle bar (centred, 48×4px, brick-white at 40% alpha)
[node name="HandleBar" type="ColorRect" parent="DragHandle"]
layout_mode = 0
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -24.0
offset_top = -2.0
offset_right = 24.0
offset_bottom = 2.0
color = Color(0.945, 0.941, 0.918, 0.4)

; ─── Body (PanelContainer) ────────────────────────────────────────────────────
; StyleBoxFlat chrome applied by _setup_panel_style() in script.
; Sits below the DragHandle.
[node name="Body" type="PanelContainer" parent="."]
layout_mode = 0
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 48.0

; ─── Main VBoxContainer ───────────────────────────────────────────────────────
[node name="VBox" type="VBoxContainer" parent="Body"]
layout_mode = 2
anchor_right = 1.0
anchor_bottom = 1.0
add_theme_constant_override("separation") = 8

; ─── Panel title ──────────────────────────────────────────────────────────────
[node name="Title" type="Label" parent="Body/VBox"]
layout_mode = 2
text = "ui.inventory.title"
add_theme_font_size_override("font_size") = 20

; ─── Tab header ───────────────────────────────────────────────────────────────
[node name="TabHeader" type="HBoxContainer" parent="Body/VBox"]
layout_mode = 2
add_theme_constant_override("separation") = 8

[node name="TabInventory" type="Button" parent="Body/VBox/TabHeader"]
layout_mode = 2
text = "ui.inventory.tab.inventory"
custom_minimum_size = Vector2(80, 40)

[node name="TabRecipes" type="Button" parent="Body/VBox/TabHeader"]
layout_mode = 2
text = "ui.inventory.tab.recipes"
custom_minimum_size = Vector2(80, 40)

; ─── Main content (vertical stack on mobile — grid then crafting) ─────────────
[node name="MainContent" type="VBoxContainer" parent="Body/VBox"]
layout_mode = 2
size_flags_vertical = 3
add_theme_constant_override("separation") = 16

; 6×8 inventory grid (48 slots built programmatically; cell size 56×56 on mobile)
[node name="InventoryGrid" type="GridContainer" parent="Body/VBox/MainContent"]
layout_mode = 2
size_flags_vertical = 3
columns = 8
add_theme_constant_override("h_separation") = 8
add_theme_constant_override("v_separation") = 8

; 2×2 crafting cluster (stacked vertically on mobile)
[node name="CraftingCluster" type="VBoxContainer" parent="Body/VBox/MainContent"]
layout_mode = 2
add_theme_constant_override("separation") = 8

[node name="CraftingLabel" type="Label" parent="Body/VBox/MainContent/CraftingCluster"]
layout_mode = 2
text = "ui.crafting.inline.heading"
add_theme_font_size_override("font_size") = 14

[node name="CraftingGrid" type="GridContainer" parent="Body/VBox/MainContent/CraftingCluster"]
layout_mode = 2
columns = 2
add_theme_constant_override("h_separation") = 8
add_theme_constant_override("v_separation") = 8

[node name="CraftingArrow" type="Label" parent="Body/VBox/MainContent/CraftingCluster"]
layout_mode = 2
text = "→"
horizontal_alignment = 1

[node name="CraftingOutput" type="Panel" parent="Body/VBox/MainContent/CraftingCluster"]
layout_mode = 2
custom_minimum_size = Vector2(56, 56)

; ─── Recipes pane (stub — Plan 03-07b wires the recipe book) ─────────────────
[node name="RecipesPane" type="Control" parent="Body/VBox"]
layout_mode = 2
size_flags_vertical = 3
visible = false

[node name="RecipesEmptyLabel" type="Label" parent="Body/VBox/RecipesPane"]
layout_mode = 0
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
text = "ui.recipes.empty.title"
horizontal_alignment = 1
