;
; creature_drops_laser_penguin.tres — thematic loot for the laser_penguin mob.
;

[gd_resource type="Resource" script_class="LootTable" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/loot/loot_table.gd" id="1_loottable"]
[ext_resource type="Script" path="res://src/loot/loot_entry.gd" id="2_lootentry"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_lootentry")
def_id = "gold_ingot"
weight = 16.0
min_count = 1
max_count = 1

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_lootentry")
def_id = "copper_ore"
weight = 26.0
min_count = 1
max_count = 2

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_lootentry")
def_id = "food_cooked_generic"
weight = 30.0
min_count = 1
max_count = 1

[resource]
script = ExtResource("1_loottable")
table_id = "creature_drops_laser_penguin"
min_rolls = 1
max_rolls = 2
entries = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3")]
