;
; structure_jungle_temple.tres — Structure table for jungle temple chest TIER selection.
; Per D-04: silver keys come from jungle temples ONLY — so jungle temples MUST contain
; silver chests exclusively. All chest slots here are silver tier (100%).
; min_rolls=1, max_rolls=1 → exactly one chest per slot.
; Anchors: 03-CONTEXT.md D-04.

[gd_resource type="Resource" script_class="LootTable" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/loot/loot_table.gd" id="1_loottable"]
[ext_resource type="Script" path="res://src/loot/loot_entry.gd" id="2_lootentry"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_lootentry")
def_id = "chest_silver"
weight = 100.0
min_count = 1
max_count = 1

[resource]
script = ExtResource("1_loottable")
table_id = "structure_jungle_temple"
min_rolls = 1
max_rolls = 1
entries = [SubResource("Resource_1")]
