;
; creature_drops.tres — LootTable for hostile creature kills.
;
; Primary loot source for creature defeat. Bronze keys drop only in dim caves
; (light_level < 0.1) per D-04; main_scene._on_hostile_died filters them in lit areas.
;
; Weight totals: key_bronze=8, food_cooked_generic=30, iron_ore=25, copper_ore=25,
;   wood_log=20, stick=20 → total weight ~128.
; Bronze key chance ~6.25% (in dim caves only), per D-04 threat balance T-03-10-MB-06.
;
; Per-creature variation (v1 polish item): one shared table. Future plans may add
; per-creature tables (slime→slime material, penguin→feathers) — see SUMMARY.md.
;
; min_rolls=1, max_rolls=2: each kill rolls 1-2 items.
; table_id="creature_drops" — matches seed_for_chest XOR convention.
;
; Anchors: 03-CONTEXT.md D-04, 03-10-PLAN.md Task 3, DOCS.md §5.2.

[gd_resource type="Resource" script_class="LootTable" load_steps=8 format=3]

[ext_resource type="Script" path="res://src/loot/loot_table.gd" id="1_loottable"]
[ext_resource type="Script" path="res://src/loot/loot_entry.gd" id="2_lootentry"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_lootentry")
def_id = "key_bronze"
weight = 8.0
min_count = 1
max_count = 1

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_lootentry")
def_id = "food_cooked_generic"
weight = 30.0
min_count = 1
max_count = 2

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_lootentry")
def_id = "iron_ore"
weight = 25.0
min_count = 1
max_count = 2

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_lootentry")
def_id = "copper_ore"
weight = 25.0
min_count = 1
max_count = 2

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("2_lootentry")
def_id = "wood_log"
weight = 20.0
min_count = 1
max_count = 2

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("2_lootentry")
def_id = "stick"
weight = 20.0
min_count = 1
max_count = 4

[resource]
script = ExtResource("1_loottable")
table_id = "creature_drops"
min_rolls = 1
max_rolls = 2
entries = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6")]
