;
; chest_bronze.tres — LootTable for bronze chest contents.
; Iron-tier tools, ore, intermediate food, rare bronze key.
; min_rolls=2, max_rolls=4 → 2-4 item rolls per open.
; Anchors: 03-CONTEXT.md D-04 (bronze key recycling in mineshafts).

[gd_resource type="Resource" script_class="LootTable" load_steps=12 format=3]

[ext_resource type="Script" path="res://src/loot/loot_table.gd" id="1_loottable"]
[ext_resource type="Script" path="res://src/loot/loot_entry.gd" id="2_lootentry"]

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_lootentry")
def_id = "iron_ore"
weight = 25.0
min_count = 1
max_count = 3

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_lootentry")
def_id = "copper_ore"
weight = 25.0
min_count = 1
max_count = 3

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_lootentry")
def_id = "food_cooked_generic"
weight = 15.0
min_count = 1
max_count = 2

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_lootentry")
def_id = "food_roasted_fish"
weight = 10.0
min_count = 1
max_count = 2

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("2_lootentry")
def_id = "pickaxe"
weight = 5.0
min_count = 1
max_count = 1

[sub_resource type="Resource" id="Resource_6"]
script = ExtResource("2_lootentry")
def_id = "shovel"
weight = 5.0
min_count = 1
max_count = 1

[sub_resource type="Resource" id="Resource_7"]
script = ExtResource("2_lootentry")
def_id = "lantern"
weight = 5.0
min_count = 1
max_count = 1

[sub_resource type="Resource" id="Resource_8"]
script = ExtResource("2_lootentry")
def_id = "key_bronze"
weight = 5.0
min_count = 1
max_count = 1

[sub_resource type="Resource" id="Resource_9"]
script = ExtResource("2_lootentry")
def_id = "torch"
weight = 5.0
min_count = 1
max_count = 2

[resource]
script = ExtResource("1_loottable")
table_id = "chest_bronze"
min_rolls = 2
max_rolls = 4
entries = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5"), SubResource("Resource_6"), SubResource("Resource_7"), SubResource("Resource_8"), SubResource("Resource_9")]
