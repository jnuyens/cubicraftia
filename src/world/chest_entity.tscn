;
; chest_entity.tscn — Placed chest entity scene.
;
; StaticBody3D root with chest_entity.gd script.
;
; Structure:
;   ChestEntity (StaticBody3D) — root, script attached
;   ├─ CollisionShape3D — BoxShape3D 1 m × 1 m × 1 m
;   ├─ Mesh (MeshInstance3D) — placeholder BoxMesh; swapped at runtime per tier
;   ├─ Lid (MeshInstance3D) — top surface for unlock animation
;   ├─ WalkupPrompt (Label3D) — billboarded 1.5 m above origin; shows open/locked prompt
;   ├─ LockPlate (MeshInstance3D) — small box front-face with lock icon; visible if locked
;   └─ AnimationPlayer — "unlock_lid" animation: tween lid rotation.x 0 → -PI/3 over 0.4 s
;
; The tier @export sets the actual mesh at runtime (Plan 03-08b spawn helper swaps mesh).
; Mesh is null placeholder per brick-mesh-null-phase2 STATE decision until art pass.

[gd_scene load_steps=13 format=3]

[ext_resource type="Script" path="res://src/world/chest_entity.gd" id="1_chest"]

[sub_resource type="BoxShape3D" id="BoxShape3D_1"]
size = Vector3(1, 1, 1)

[sub_resource type="BoxMesh" id="BoxMesh_body"]
size = Vector3(1, 1, 1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_body"]
albedo_color = Color(0.5, 0.32, 0.16, 1)
roughness = 1.0

[sub_resource type="BoxMesh" id="BoxMesh_lid"]
size = Vector3(0.9, 0.2, 0.9)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_lid"]
albedo_color = Color(0.34, 0.21, 0.1, 1)
roughness = 1.0

[sub_resource type="BoxMesh" id="BoxMesh_lock"]
size = Vector3(0.2, 0.2, 0.05)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_lock"]
albedo_color = Color(0.106, 0.173, 0.337, 1)

[sub_resource type="BoxMesh" id="BoxMesh_latch"]
size = Vector3(0.18, 0.3, 0.06)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gold"]
albedo_color = Color(0.85, 0.68, 0.25, 1)
metallic = 0.6
roughness = 0.4

[sub_resource type="Animation" id="Animation_unlock_lid"]
resource_name = "unlock_lid"
length = 0.4
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("../Lid:rotation")
tracks/0/interp = 2
tracks/0/loop_wrap = false
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.4),
"transitions": PackedFloat32Array(1, 1),
"update": 0,
"values": [Vector3(0, 0, 0), Vector3(-1.0472, 0, 0)]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_1"]
_data = {"unlock_lid": SubResource("Animation_unlock_lid")}

[node name="ChestEntity" type="StaticBody3D"]
script = ExtResource("1_chest")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 0)
shape = SubResource("BoxShape3D_1")

[node name="Mesh" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, 0)
mesh = SubResource("BoxMesh_body")
surface_material_override/0 = SubResource("StandardMaterial3D_body")

[node name="Lid" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.1, 0)
mesh = SubResource("BoxMesh_lid")
surface_material_override/0 = SubResource("StandardMaterial3D_lid")

[node name="Latch" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -0.5)
mesh = SubResource("BoxMesh_latch")
surface_material_override/0 = SubResource("StandardMaterial3D_gold")

[node name="WalkupPrompt" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
billboard = 1
no_depth_test = true
pixel_size = 0.005
outline_size = 4
text = ""
modulate = Color(0.945, 0.941, 0.918, 1)
visible = false

[node name="LockPlate" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, -0.525)
mesh = SubResource("BoxMesh_lock")
surface_material_override/0 = SubResource("StandardMaterial3D_lock")
visible = false

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries = {"": SubResource("AnimationLibrary_1")}
