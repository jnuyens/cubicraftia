;
; recipe_workbench.tres — 4 wooden planks filling the 2×2 grid → 1 workbench (shaped, 2×2).
; The workbench unlocks the 3×3 crafting grid. 11th recipe per CONTEXT D-07 / ROADMAP SC#3 "~10".
; Ref: 03-07a-SUMMARY.md for workbench-craft justification.

[gd_resource type="Resource" script_class="Recipe" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/crafting/recipe.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
recipe_id = "recipe_workbench"
display_name_key = "recipes.workbench.name"
inputs = [{"def_id": "wood_plank", "count": 1, "slot": 0}, {"def_id": "wood_plank", "count": 1, "slot": 1}, {"def_id": "wood_plank", "count": 1, "slot": 2}, {"def_id": "wood_plank", "count": 1, "slot": 3}]
output_def_id = "workbench"
output_count = 1
shaped = true
grid_size = 2
