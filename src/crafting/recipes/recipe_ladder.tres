;
; recipe_ladder.tres — H-pattern sticks → 3 ladders (shaped, 3×3 grid).
; Slots 0,2,3,5,6,8 = stick (left-col, rungs, right-col); slots 1,7 empty.
; D-07: recipe ratios at Claude's discretion. Ref: 03-07a-SUMMARY.md.

[gd_resource type="Resource" script_class="Recipe" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/crafting/recipe.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
recipe_id = "recipe_ladder"
display_name_key = "recipes.ladder.name"
inputs = [{"def_id": "stick", "count": 1, "slot": 0}, {"def_id": "stick", "count": 1, "slot": 2}, {"def_id": "stick", "count": 1, "slot": 3}, {"def_id": "stick", "count": 1, "slot": 5}, {"def_id": "stick", "count": 1, "slot": 6}, {"def_id": "stick", "count": 1, "slot": 8}]
output_def_id = "ladder"
output_count = 3
shaped = true
grid_size = 3
