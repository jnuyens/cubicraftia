;
; recipe_chest.tres — 8 wooden planks in border (all slots except centre) → 1 chest (shaped, 3×3).
; Slots 0,1,2,3,5,6,7,8 = wooden plank; slot 4 (centre) = empty.
; D-07: recipe ratios at Claude's discretion. Ref: 03-07a-SUMMARY.md.

[gd_resource type="Resource" script_class="Recipe" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/crafting/recipe.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
recipe_id = "recipe_chest"
display_name_key = "recipes.chest.name"
inputs = [{"def_id": "wood_plank", "count": 1, "slot": 0}, {"def_id": "wood_plank", "count": 1, "slot": 1}, {"def_id": "wood_plank", "count": 1, "slot": 2}, {"def_id": "wood_plank", "count": 1, "slot": 3}, {"def_id": "wood_plank", "count": 1, "slot": 5}, {"def_id": "wood_plank", "count": 1, "slot": 6}, {"def_id": "wood_plank", "count": 1, "slot": 7}, {"def_id": "wood_plank", "count": 1, "slot": 8}]
output_def_id = "chest_regular"
output_count = 1
shaped = true
grid_size = 3
