;
; ghost.tscn — Ghost: wall-passing hostile that phases through bricks and terrain.
;
; Visual placeholder: white-grey sphere at 0.6α transparency per UI-SPEC L151.
; collision_layer=0 / collision_mask=0 set in ghost.gd _ready() for wall-pass.
; TODO Phase 3 polish: phase-shimmer distortion shader on body per UI-SPEC L79 (v1 uses modulate alpha).
; TODO Phase 3 polish: replace Body placeholder with distinct ghost .glb per art pass.
;
; D-09 tell nodes:
;   ShimmerParticles — GPUParticles3D one-shot burst at bed-bubble boundary (D-10).
;   ChimeAudio       — AudioStreamPlayer3D (stream null v1; TODO: wire chime.ogg).
;
; References: ghost.gd, 03-CONTEXT.md D-09 + D-10, 03-PATTERNS.md L432-440.

[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/combat/ghost.gd" id="1_script"]

[sub_resource type="SphereShape3D" id="SphereShape3D_1"]
radius = 0.4

[sub_resource type="SphereMesh" id="SphereMesh_body"]
radius = 0.38
height = 0.76

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_shimmer"]
emission_shape = 1
emission_sphere_radius = 0.4
direction = Vector3(0, 0, 0)
spread = 180.0
initial_velocity_min = 0.5
initial_velocity_max = 2.0
color = Color(1, 1, 1, 0.7)

[node name="Ghost" type="CharacterBody3D"]
script = ExtResource("1_script")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, 0)
shape = SubResource("SphereShape3D_1")

[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.4, 0)
mesh = SubResource("SphereMesh_body")

[node name="ShimmerParticles" type="GPUParticles3D" parent="."]
emitting = false
amount = 16
lifetime = 0.5
one_shot = true
process_material = SubResource("ParticleProcessMaterial_shimmer")

[node name="ChimeAudio" type="AudioStreamPlayer3D" parent="."]
max_distance = 18.0
