;
; food_pie.tres — Pie ItemDefinition (the "labour of love" food, D-13).
; Highest-heal cooked food at 4 HP — found only in higher-tier chests and structures.
; Per D-13: cooked food is found-only loot in v1 (no farming/cooking pipeline).
; Design rationale: pie requires the most effort to prepare IRL, so it heals more.

[gd_resource type="Resource" script_class="ItemDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/items/item_definition.gd" id="1_itemdef"]

[resource]
script = ExtResource("1_itemdef")
item_id = "food_pie"
display_name_key = "items.food_pie.name"
icon_path = "res://assets/textures/icons/food_pie.png"
category = "cooked_food"
max_stack = 64
tier = ""
heal_amount = 4
consumed_on_use = true
vfx_on_use = ""
