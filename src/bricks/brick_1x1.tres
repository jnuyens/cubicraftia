studs_top = [{"x": 0.0, "y": 1.0, "z": 0.0, "gender": "male"}]
studs_bottom = [{"x": 0.0, "y": 0.0, "z": 0.0, "gender": "female"}]
stud_profile = "concave_top"
material_id = "plastic_solid"
mesh = null
category = 0
palette_colour_index = -1
colour_swappable = true
natural_colour_token = -1
