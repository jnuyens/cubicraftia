[ext_resource type="Script" path="res://src/items/item_definition.gd" id="1_itemdef"]

[resource]
script = ExtResource("1_itemdef")
item_id = "key_gold"
display_name_key = "items.key_gold.name"
icon_path = "res://assets/textures/icons/key_gold.png"
category = "key"
max_stack = 64
tier = "gold"
heal_amount = 0
consumed_on_use = true
